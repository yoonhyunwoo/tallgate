<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />

            <TextView
                style="@style/TallGate.Text"
                android:layout_marginTop="16dp"
                android:text="@string/disclosure_title"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TallGate.Text"
                android:layout_marginTop="12dp"
                android:text="@string/disclosure_intro"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/TallGate.RowTitle"
                        android:text="@string/disclosure_access_title" />

                    <TextView
                        style="@style/TallGate.RowSubtitle"
                        android:text="@string/disclosure_access_body" />

                    <View
                        style="@style/TallGate.Divider"
                        android:layout_marginVertical="16dp" />

                    <TextView
                        style="@style/TallGate.RowTitle"
                        android:text="@string/disclosure_use_title" />

                    <TextView
                        style="@style/TallGate.RowSubtitle"
                        android:text="@string/disclosure_use_body" />

                    <View
                        style="@style/TallGate.Divider"
                        android:layout_marginVertical="16dp" />

                    <TextView
                        style="@style/TallGate.RowTitle"
                        android:text="@string/disclosure_privacy_title" />

                    <TextView
                        style="@style/TallGate.RowSubtitle"
                        android:text="@string/disclosure_privacy_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TallGate.Text"
                android:layout_marginTop="16dp"
                android:text="@string/disclosure_footer"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgree"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/disclosure_agree" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDecline"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/disclosure_decline"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
