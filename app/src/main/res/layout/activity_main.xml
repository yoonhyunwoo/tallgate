<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="48dp">

        <TextView
            style="@style/TallGate.Text"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/TallGate.Text"
            android:layout_marginTop="4dp"
            android:text="숏폼 무한 스크롤 방지 게이트웨이"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            tools:cardBackgroundColor="@color/status_active_bg"
            tools:strokeColor="@color/status_active_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout style="@style/TallGate.Row">

                    <TextView
                        android:id="@+id/tvStatusIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        tools:text="🟢" />

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="TallGate 보호 활성화됨"
                        tools:textColor="@color/status_active_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatusDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    tools:text="설정한 앱의 숏폼 및 탐색 기능이 차단되고 있습니다."
                    tools:textColor="@color/status_active_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnableService"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_enable_accessibility"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TallGate.SectionLabel"
            android:layout_marginTop="28dp"
            android:text="@string/section_apps" />

        <com.google.android.material.card.MaterialCardView
            style="@style/TallGate.Card"
            android:layout_marginBottom="14dp">

            <LinearLayout style="@style/TallGate.CardBody">

                <LinearLayout style="@style/TallGate.Row">

                    <TextView
                        style="@style/TallGate.AppIcon"
                        android:text="📷" />

                    <TextView
                        style="@style/TallGate.AppName"
                        android:text="@string/app_instagram" />

                    <TextView
                        style="@style/TallGate.Badge"
                        android:text="@string/app_instagram"
                        android:textColor="@color/brand_instagram" />
                </LinearLayout>

                <View style="@style/TallGate.Divider" />

                <LinearLayout style="@style/TallGate.Row">

                    <LinearLayout style="@style/TallGate.RowText">

                        <TextView
                            style="@style/TallGate.FeatureTitle"
                            android:text="@string/feature_insta_reels" />

                        <TextView
                            style="@style/TallGate.FeatureDesc"
                            android:text="@string/feature_insta_reels_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchInstaReels"
                        style="@style/TallGate.Switch" />
                </LinearLayout>

                <LinearLayout
                    style="@style/TallGate.Row"
                    android:layout_marginTop="16dp">

                    <LinearLayout style="@style/TallGate.RowText">

                        <TextView
                            style="@style/TallGate.FeatureTitle"
                            android:text="@string/feature_insta_explore" />

                        <TextView
                            style="@style/TallGate.FeatureDesc"
                            android:text="@string/feature_insta_explore_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchInstaExplore"
                        style="@style/TallGate.Switch" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/TallGate.Card"
            android:layout_marginBottom="14dp">

            <LinearLayout style="@style/TallGate.CardBody">

                <LinearLayout style="@style/TallGate.Row">

                    <TextView
                        style="@style/TallGate.AppIcon"
                        android:text="▶️" />

                    <TextView
                        style="@style/TallGate.AppName"
                        android:text="@string/app_youtube" />

                    <TextView
                        style="@style/TallGate.Badge"
                        android:text="@string/app_youtube"
                        android:textColor="@color/brand_youtube" />
                </LinearLayout>

                <View style="@style/TallGate.Divider" />

                <LinearLayout style="@style/TallGate.Row">

                    <LinearLayout style="@style/TallGate.RowText">

                        <TextView
                            style="@style/TallGate.FeatureTitle"
                            android:text="@string/feature_yt_shorts" />

                        <TextView
                            style="@style/TallGate.FeatureDesc"
                            android:text="@string/feature_yt_shorts_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchYtShorts"
                        style="@style/TallGate.Switch" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/TallGate.Card"
            android:layout_marginBottom="14dp">

            <LinearLayout style="@style/TallGate.CardBody">

                <LinearLayout style="@style/TallGate.Row">

                    <TextView
                        style="@style/TallGate.AppIcon"
                        android:text="🎵" />

                    <TextView
                        style="@style/TallGate.AppName"
                        android:text="@string/app_tiktok" />

                    <TextView
                        style="@style/TallGate.Badge"
                        android:text="@string/app_tiktok"
                        android:textColor="@color/brand_tiktok" />
                </LinearLayout>

                <View style="@style/TallGate.Divider" />

                <LinearLayout style="@style/TallGate.Row">

                    <LinearLayout style="@style/TallGate.RowText">

                        <TextView
                            style="@style/TallGate.FeatureTitle"
                            android:text="@string/feature_tiktok_feed" />

                        <TextView
                            style="@style/TallGate.FeatureDesc"
                            android:text="@string/feature_tiktok_feed_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchTiktokFeed"
                        style="@style/TallGate.Switch" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TallGate.SectionLabel"
            android:layout_marginTop="20dp"
            android:text="@string/section_preferences" />

        <com.google.android.material.card.MaterialCardView style="@style/TallGate.Card">

            <LinearLayout style="@style/TallGate.CardBody">

                <LinearLayout style="@style/TallGate.Row">

                    <LinearLayout style="@style/TallGate.RowText">

                        <TextView
                            style="@style/TallGate.FeatureTitle"
                            android:text="@string/pref_haptic" />

                        <TextView
                            style="@style/TallGate.FeatureDesc"
                            android:text="@string/pref_haptic_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchHaptic"
                        style="@style/TallGate.Switch" />
                </LinearLayout>

                <View style="@style/TallGate.Divider" />

                <LinearLayout style="@style/TallGate.Row">

                    <LinearLayout style="@style/TallGate.RowText">

                        <TextView
                            style="@style/TallGate.FeatureTitle"
                            android:text="@string/pref_toast" />

                        <TextView
                            style="@style/TallGate.FeatureDesc"
                            android:text="@string/pref_toast_desc" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchToast"
                        style="@style/TallGate.Switch" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
