<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />

            <TextView
                style="@style/TallGate.Text"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/header_title"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/warning_bg"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/warning_stroke"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/TallGate.Text"
                    android:text="@string/status_inactive_title"
                    android:textColor="@color/warning_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TallGate.Text"
                    android:layout_marginTop="8dp"
                    android:text="@string/status_inactive_desc"
                    android:textColor="@color/warning_text"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnableService"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_enable_accessibility" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="8dp">

                <TextView
                    style="@style/TallGate.Text"
                    android:layout_marginBottom="8dp"
                    android:text="@string/section_apps"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout style="@style/TallGate.Row">

                    <ImageView
                        style="@style/TallGate.AppIcon"
                        android:src="@drawable/ic_app_youtube" />

                    <LinearLayout style="@style/TallGate.RowText">

                        <TextView
                            style="@style/TallGate.RowTitle"
                            android:text="@string/app_youtube" />

                        <TextView
                            style="@style/TallGate.RowSubtitle"
                            android:text="@string/target_shorts" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchYtShorts"
                        style="@style/TallGate.Switch"
                        android:contentDescription="@string/switch_yt_shorts" />
                </LinearLayout>

                <View style="@style/TallGate.Divider" />

                <LinearLayout style="@style/TallGate.Row">

                    <ImageView
                        style="@style/TallGate.AppIcon"
                        android:src="@drawable/ic_app_instagram" />

                    <LinearLayout style="@style/TallGate.RowText">

                        <TextView
                            style="@style/TallGate.RowTitle"
                            android:text="@string/app_instagram" />

                        <TextView
                            style="@style/TallGate.RowSubtitle"
                            android:text="@string/target_reels" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchInstaReels"
                        style="@style/TallGate.Switch"
                        android:contentDescription="@string/switch_insta_reels" />
                </LinearLayout>

                <View style="@style/TallGate.Divider" />

                <LinearLayout style="@style/TallGate.Row">

                    <ImageView
                        style="@style/TallGate.AppIcon"
                        android:src="@drawable/ic_app_instagram" />

                    <LinearLayout style="@style/TallGate.RowText">

                        <TextView
                            style="@style/TallGate.RowTitle"
                            android:text="@string/app_instagram" />

                        <TextView
                            style="@style/TallGate.RowSubtitle"
                            android:text="@string/target_explore" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchInstaExplore"
                        style="@style/TallGate.Switch"
                        android:contentDescription="@string/switch_insta_explore" />
                </LinearLayout>

                <View style="@style/TallGate.Divider" />

                <LinearLayout style="@style/TallGate.Row">

                    <ImageView
                        style="@style/TallGate.AppIcon"
                        android:src="@drawable/ic_app_tiktok" />

                    <LinearLayout style="@style/TallGate.RowText">

                        <TextView
                            style="@style/TallGate.RowTitle"
                            android:text="@string/app_tiktok" />

                        <TextView
                            style="@style/TallGate.RowSubtitle"
                            android:text="@string/target_for_you" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchTiktokFeed"
                        style="@style/TallGate.Switch"
                        android:contentDescription="@string/switch_tiktok_feed" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="8dp">

                <TextView
                    style="@style/TallGate.Text"
                    android:layout_marginBottom="8dp"
                    android:text="@string/section_feedback"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout style="@style/TallGate.Row">

                    <LinearLayout
                        style="@style/TallGate.RowText"
                        android:layout_marginStart="0dp">

                        <TextView
                            style="@style/TallGate.RowTitle"
                            android:text="@string/pref_haptic" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchHaptic"
                        style="@style/TallGate.Switch"
                        android:contentDescription="@string/pref_haptic" />
                </LinearLayout>

                <View style="@style/TallGate.Divider" />

                <LinearLayout style="@style/TallGate.Row">

                    <LinearLayout
                        style="@style/TallGate.RowText"
                        android:layout_marginStart="0dp">

                        <TextView
                            style="@style/TallGate.RowTitle"
                            android:text="@string/pref_toast" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchToast"
                        style="@style/TallGate.Switch"
                        android:contentDescription="@string/pref_toast" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
